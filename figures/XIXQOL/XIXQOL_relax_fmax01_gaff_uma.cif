data_from_pyxtal
#Energy: -77.96301313221917 eV/cell

_symmetry_space_group_name_H-M 'A 1 n 1'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a           10.014019
_cell_length_b           11.355928
_cell_length_c            4.742081
_cell_angle_alpha        90.000000
_cell_angle_beta         76.303893
_cell_angle_gamma        90.000000
_cell_volume            523.928482

loop_
