data_from_pyxtal

_symmetry_space_group_name_H-M 'Fdd2'
_symmetry_Int_Tables_number                   43
_symmetry_cell_setting              orthorhombic
_cell_length_a           12.001500
_cell_length_b           17.642500
_cell_length_c            4.555500
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume            964.565461

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x, -y, z'
3 'x+1/4, -y+1/4, z+1/4'
4 '-x+1/4, y+1/4, z+1/4'
5 'x, y+1/2, z+1/2'
6 '-x, -y+1/2, z+1/2'
7 'x+1/4, -y+3/4, z+3/4'
8 '-x+1/4, y+3/4, z+3/4'
9 'x+1/2, y, z+1/2'
10 '-x+1/2, -y, z+1/2'
11 'x+3/4, -y+1/4, z+3/4'
12 '-x+3/4, y+1/4, z+3/4'
13 'x+1/2, y+1/2, z'
14 '-x+1/2, -y+1/2, z'
15 'x+3/4, -y+3/4, z+1/4'
16 '-x+3/4, y+3/4, z+1/4'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        8     0.000000   -0.000000    0.080800 1
C      C        8     0.000000   -0.000000    0.345800 1
N      N       16    -0.088300    0.022570    0.522100 1
N      N       16    -0.177020    0.064860    0.412000 1
O      O       16    -0.255980    0.070430    0.579300 1
O      O       16    -0.169930    0.092490    0.168700 1
H      H       16    -0.088300    0.009800    0.708800 1
