data_from_pyxtal
#Energy: -155.000315 eV/cell

_symmetry_space_group_name_H-M 'A 1 n 1'
_symmetry_Int_Tables_number                    9
_symmetry_cell_setting                monoclinic
_cell_length_a            9.110576
_cell_length_b           12.001500
_cell_length_c            4.555500
_cell_angle_alpha        90.000000
_cell_angle_beta         75.521799
_cell_angle_gamma        90.000000
_cell_volume            482.282725

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 'x-1/2, -y, z-1/2'
3 'x, y+1/2, z+1/2'
4 'x-1/2, -y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
O      O        4     1.000000    0.875000    0.084000 1
C      C        4     1.000000    0.875000    0.351000 1
N      N        4     0.948000    0.789000    0.543000 1
N      N        4     0.868000    0.692000    0.470000 1
O      O        4     0.840000    0.618000    0.660000 1
O      O        4     0.828000    0.692000    0.234000 1
N      N        4     1.052000    0.961000    0.491000 1
N      N        4     1.132000    1.058000    0.338000 1
O      O        4     1.172000    1.058000    0.062000 1
O      O        4     1.160000    1.132000    0.500000 1
H      H        4     0.954000    0.792000    0.761000 1
H      H        4     1.046000    0.958000    0.716000 1
#END

