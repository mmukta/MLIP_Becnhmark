data_from_pyxtal
#Energy: -76.1823621 eV/cell

_symmetry_space_group_name_H-M 'P 1 21/n 1'
_symmetry_Int_Tables_number                   14
_symmetry_cell_setting                monoclinic
_cell_length_a            5.914100
_cell_length_b           21.524400
_cell_length_c            6.035700
_cell_angle_alpha        90.000000
_cell_angle_beta         80.924000
_cell_angle_gamma        90.000000
_cell_volume            758.709738

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x-1/2, y+1/2, -z-1/2'
3 '-x, -y, -z'
4 'x-1/2, -y+1/2, z-1/2'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
