data_from_pyxtal

_symmetry_space_group_name_H-M 'Pbca'
_symmetry_Int_Tables_number                   61
_symmetry_cell_setting              orthorhombic
_cell_length_a            7.205000
_cell_length_b           15.802000
_cell_length_c           14.300000
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma        90.000000
_cell_volume           1628.103763

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-x+1/2, -y, z+1/2'
3 '-x, y+1/2, -z+1/2'
4 'x+1/2, -y+1/2, -z'
5 '-x, -y, -z'
6 'x+1/2, y, -z+1/2'
7 'x, -y+1/2, z+1/2'
8 '-x+1/2, y+1/2, z'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
